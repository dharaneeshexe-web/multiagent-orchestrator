# ── Required ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── LangSmith (optional) ────────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=multiagent-orchestrator

# ── App settings ─────────────────────────────────────────────────────────────
MAX_RETRY_LOOPS=2
HALLUCINATION_THRESHOLD=6
PRIMARY_MODEL=llama-3.3-70b-versatile
FALLBACK_MODEL=llama3-8b-8192

# ── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Qdrant ───────────────────────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=knowledge

# ── Observability ────────────────────────────────────────────────────────────
OTLP_ENDPOINT=http://jaeger:4317

# ── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://multiagent:change_this_password@postgres:5432/multiagent
POSTGRES_USER=multiagent
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=multiagent

# ── Prefect ──────────────────────────────────────────────────────────────────
PREFECT_API_URL=http://prefect:4200/api
